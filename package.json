{
  "name": "monet-local",
  "version": "0.1.2",
  "description": "Local model server for Code Monet, built on llama.cpp",
  "main": "./out/main/index.js",
  "type": "module",
  "private": true,
  "author": "iaa2005",
  "scripts": {
    "dev": "node scripts/dev-quiet.mjs",
    "dev:raw": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "package": "npm run build && electron-builder",
    "package:local": "npm run build && electron-builder --config.win.signAndEditExecutable=false",
    "release": "npm run build && electron-builder --publish always",
    "figures": "node scripts/build-figures.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.0",
    "electron-updater": "^6.8.9",
    "fflate": "^0.8.3",
    "katex": "^0.16.47",
    "lucide-react": "^0.400.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwind-merge": "^2.5.0",
    "zod": "^3.25.76",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.2",
    "@types/katex": "^0.16.8",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0",
    "electron-vite": "^2.3.0",
    "postcss": "^8.4.0",
    "tailwindcss": "^4.3.2",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
